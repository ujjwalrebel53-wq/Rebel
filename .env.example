# === Copilot API (OpenAI-compatible proxy) ===
# Run one of: ericc-ch/copilot-api, yuchanns/copilot-openai-api, etc.
# Example: npx @ericc-ch/copilot-api  →  http://127.0.0.1:4141/v1
COPILOT_API_BASE=http://127.0.0.1:4141/v1
COPILOT_API_KEY=copilot
COPILOT_MODEL=gpt-4o

# === Workspace (project folder the agent edits) ===
WORKSPACE_ROOT=/path/to/your/project

# === GitHub (for push + PR tools) ===
GITHUB_TOKEN=ghp_xxxxxxxx
GITHUB_REPO=your-username/your-repo
DEFAULT_BRANCH=main

# === Server ===
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
